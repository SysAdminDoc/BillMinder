<?xml version="1.0" encoding="utf-8"?>
<!--
    The Play build declares no location permissions. Home geofencing needed background location,
    which Play grants only against a reviewed declaration BillMinder does not hold, so the feature
    is not shipped rather than shipped with an undeclared permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name=".wear.WearMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/billminder/mark-paid" />
            </intent-filter>
        </service>
    </application>

</manifest>
